<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avaloniaEdit="using:AvaloniaEdit"
             xmlns:viewModels="clr-namespace:KyroClient.Desktop.Main.ViewModels"
             x:Class="KyroClient.Desktop.QueryEditor.Views.QueryEditorView"
             x:DataType="viewModels:MainWindowViewModel"
             >

    <avaloniaEdit:TextEditor x:Name="Editor"
                             FontFamily="JetBrains Mono, Cascadia Code, Consolas, monospace"
                             FontSize="14"
                             Background="#1E1F22"
                             Foreground="#BCBEC4"
                             ShowLineNumbers="True"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             WordWrap="False" 
                             Document="{Binding SqlCommand}"
                             />
</UserControl>