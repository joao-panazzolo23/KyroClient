<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:KyroClient.Desktop.Main.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="KyroClient.Desktop.ResultConsole.Views.ResultConsoleView"
             x:DataType="viewModels:MainWindowViewModel"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch"
             x:CompileBindings="False">

    <Border Background="#1E1F22"
            BorderThickness="0,1,0,0"
            BorderBrush="#3C3F41"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch">
        
        <Grid VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0"
                    Background="#2B2D30"
                    BorderThickness="0,0,0,1"
                    BorderBrush="#3C3F41">
                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center"
                            Margin="12,0">
                    <Button Width="24" Height="24"
                            CornerRadius="5"
                            ToolTip.Tip="Run query"
                            Command="{Binding ExecuteQueryCommand}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Background" Value="#1B3A25" />
                                <Setter Property="BorderBrush" Value="#3A8A52" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#2D6A3F" />
                            </Style>
                        </Button.Styles>
                        <PathIcon Width="10" Height="10"
                                  Data="M 1,0 L 10,5 L 1,10 Z"
                                  Foreground="#4CAF76" />
                    </Button>
                    <Border Width="1" Height="20" Background="#3C3F41" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="manual" FontSize="14" Foreground="#7A7E85" VerticalAlignment="Center" />
                        <ToggleSwitch OnContent="" OffContent="" Margin="0" Padding="0" MinWidth="0" />
                        <TextBlock Text="auto" FontSize="14" Foreground="#7A7E85" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- <TextBlock x:Name="ResultsGrid" -->
            <!--            Grid.Row="1" -->
            <!--            Text="waiting..." -->
            <!--            Foreground="#BCBEC4" /> -->

            <!-- DataGrid fills all remaining space -->
            <DataGrid Grid.Row="1"
                      x:Name="ResultsGrid"
                      Background="Transparent"
                      RowBackground="#1E1F22"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#2B2D30"
                      VerticalGridLinesBrush="#2B2D30"
                      BorderThickness="0"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      FontSize="12"
                      FontFamily="JetBrains Mono, Cascadia Code, Consolas, monospace"
                      Foreground="#BCBEC4"
                      HeadersVisibility="Column"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch" />

            <!-- Status bar -->
            <Border Grid.Row="2"
                    Background="#2B2D30"
                    Padding="12,4"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#3C3F41">
                <DockPanel>
                    <TextBlock x:Name="RowCountText"
                               Text="0 rows"
                               FontSize="11"
                               Foreground="#7A7E85" />
                    <TextBlock x:Name="ElapsedText"
                               Text=""
                               FontSize="11"
                               Foreground="#7A7E85"
                               HorizontalAlignment="Right" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
