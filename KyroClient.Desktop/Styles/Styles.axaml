<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="using:Material.Icons.Avalonia">

    <Style Selector="Button.sidebar-icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="4,2" />
    </Style>
    <Style Selector="Button.sidebar-icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#3C3F41" />
    </Style>
    <Style Selector="Button.sidebar-icon.active /template/ ContentPresenter">
        <Setter Property="Background" Value="#2D3A4A" />
    </Style>

    <Style Selector="Button.sidebar-icon material|MaterialIcon">
        <Setter Property="Foreground" Value="#7A7E85" />
    </Style>
    <Style Selector="Button.sidebar-icon.active material|MaterialIcon">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

</Styles>