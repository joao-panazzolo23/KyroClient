<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:material="using:Material.Icons.Avalonia"
             xmlns:viewModels="using:KyroClient.Desktop.Main.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="viewModels:MainWindowViewModel"
             x:Class="KyroClient.Desktop.Sidebar.Views.SidebarView"
             x:Name="Self">

    <DockPanel Background="{StaticResource SidebarBgBrush}">

        <!-- Icon Strip -->
        <Border DockPanel.Dock="Left"
                Background="{StaticResource IconStripBgBrush}"
                Width="48"
                BorderThickness="0,0,1,0"
                BorderBrush="{StaticResource SeparatorBrush}">
            <DockPanel>

                <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="0,8,0,0">

                    <Button Classes="sidebar-icon active"
                            x:Name="BtnConnections"
                            ToolTip.Tip="Connections"
                            Click="OnIconClick"
                            Tag="Connections">
                        <material:MaterialIcon Kind="Database"
                                               Width="20" Height="20" />
                    </Button>

                    <Button Classes="sidebar-icon"
                            x:Name="BtnSwitchDb"
                            ToolTip.Tip="Switch Database"
                            Click="OnIconClick"
                            Tag="SwitchDb">
                        <material:MaterialIcon Kind="DatabaseArrowRight"
                                               Width="20" Height="20" />
                    </Button>

                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,0,0,8">

                    <Button Classes="sidebar-icon"
                            x:Name="BtnSettings"
                            ToolTip.Tip="Settings"
                            Click="OnIconClick"
                            Tag="Settings">
                        <material:MaterialIcon Kind="Cog"
                                               Width="20" Height="20" />
                    </Button>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Expandable Panel -->
        <Border x:Name="PanelContainer"
                Background="{StaticResource SidebarBgBrush}"
                BorderThickness="0,0,1,0"
                BorderBrush="{StaticResource SeparatorBrush}">

            <DockPanel>

                <Border DockPanel.Dock="Top"
                        Padding="12,10,8,10"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{StaticResource SeparatorBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Classes="sidebar-icon"
                                Width="24" Height="24"
                                Margin="0"
                                ToolTip.Tip="Close"
                                Click="OnClosePanel">
                            <material:MaterialIcon Kind="Close"
                                                   Width="14" Height="14"
                                                   Foreground="{StaticResource FgMutedBrush}" />
                        </Button>
                        <TextBlock x:Name="PanelTitle"
                                   Text="Connections"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   LetterSpacing="0.5"
                                   Foreground="{StaticResource FgDefaultBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="PanelContent" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>