<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="using:KyroClient.Desktop.Main.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="KyroClient.Desktop.Main.Views.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        xmlns:sidebar="using:KyroClient.Desktop.Sidebar.Views"
        xmlns:views="using:KyroClient.Desktop.QueryEditor.Views"
        xmlns:console="using:KyroClient.Desktop.ResultConsole.Views"
        Width="1400"
        Height="900"
        Background="#1E1F22"
        ExtendClientAreaToDecorationsHint="True"
        Title="KyroClient.Desktop">
    <!-- ExtendClientAreaChromeHints="NoChrome" -->
    <!-- Icon="/Assets/avalonia-logo.ico" -->

    <Design.DataContext>
        <viewModels:MainWindowViewModel />
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="48" MaxWidth="600" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <sidebar:SidebarView Grid.Column="0" x:Name="Sidebar" />

        <GridSplitter Grid.Column="1"
                      ResizeDirection="Columns"
                      Background="#3C3F41"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Cursor="SizeWestEast" />

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
                <RowDefinition Height="250" />
            </Grid.RowDefinitions>

            <views:QueryEditorView Grid.Row="0" />

            <GridSplitter Grid.Row="1"
                          ResizeDirection="Rows"
                          Background="#3C3F41"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Cursor="SizeNorthSouth" />

            <console:ResultConsoleView Grid.Row="2" />
        </Grid>

    </Grid>

</Window>